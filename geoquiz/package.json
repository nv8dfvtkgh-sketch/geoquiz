{
  "name": "geoquiz",
  "version": "1.0.0",
  "private": true,
  "description": "Quiz de géographie multilingue et multijoueur (cartes cliquables, duels, salles en direct).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "data:demo": "tsx scripts/demo-data.ts && tsx scripts/build-data.ts --demo",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "build:cf": "npm run data && node scripts/build.mjs --cf",
    "cf:dev": "node scripts/build.mjs --cf && wrangler dev",
    "cf:deploy": "npm run build:cf && wrangler deploy",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "flag-icons": "^7.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.40.0"
  }
}
