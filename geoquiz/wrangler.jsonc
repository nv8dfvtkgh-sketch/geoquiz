// Configuration Cloudflare Workers (déploiement : voir DEPLOY-CLOUDFLARE.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geoquiz",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",

  // Pages, scripts, styles et données du jeu. Le Worker passe en premier pour l'API,
  // les WebSockets, /data/* (bloqué au public : les noms des lieux sont les réponses)
  // et /defi/* (aperçu personnalisé du lien partagé).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/data/*", "/defi/*"]
  },

  // Une partie = un Durable Object ; la partie rapide = un Durable Object unique.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "QUICK", "class_name": "QuickDO" },
      { "name": "QUIZZES", "class_name": "QuizDO" },
      { "name": "ACCOUNTS", "class_name": "AccountsDO" }
    ]
  },
  // Classes « SQLite » : disponibles sur le forfait gratuit.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "QuickDO"] },
    { "tag": "v2", "new_sqlite_classes": ["QuizDO"] },
    { "tag": "v3", "new_sqlite_classes": ["AccountsDO"] }
  ],

  "vars": { "MAX_PLAYERS": "50" },
  "observability": { "enabled": true }
}
